# Server
PORT=3001
CORS_ORIGIN=http://localhost:5173

# JWT: use a long, random value (at least 32 characters) stored in your secret manager.
JWT_SECRET=replace-with-a-long-random-secret
JWT_ISSUER=frac-api
JWT_AUDIENCE=frac-web

# LDAP (optional when the portal uses only normal authentication). The service
# account searches for the user, then the API binds as that user to verify their password.
LDAP_URL=ldaps://ldap.example.internal:636
LDAP_BIND_DN=CN=frac-api,OU=Service Accounts,DC=example,DC=internal
LDAP_BIND_PASSWORD=replace-me
LDAP_BASE_DN=OU=Users,DC=example,DC=internal
LDAP_USERNAME_ATTRIBUTE=sAMAccountName
LDAP_EMAIL_ATTRIBUTE=mail

# PostgreSQL is used for normal (non-LDAP) users in public.app_users.
DATABASE_URL=postgresql://frac_app:replace-me@postgres.example.internal:5432/frac_data

# Exchange Web Services (EWS) using Windows/NTLM authentication. Messages are
# sent from the mailbox associated with EWS_USERNAME.
EWS_URL=https://mail.eug.petroleum.gov.eg/ews/Exchange.asmx
EWS_USERNAME=EUG\mmaher
EWS_PASSWORD=Il0vedads0much!@#$%^
# Keep false in production. Set true only when your internal Exchange server
# uses a self-signed certificate and its certificate chain cannot be trusted.
EWS_ALLOW_UNTRUSTED_CERTIFICATE=false
